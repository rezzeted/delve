# Delve slot asset: decor drain v2 (slots §2.6) — round forged-iron sewer
# grate set into the stone floor (ref: projects/iso/refs_tmp). Radial ashlar
# surround (12 blocks with mortar-thin angular gaps, per-block height/shade
# jitter, ~10% warm stones like the fill setts), outer rim ring + one inner
# ring with rivet heads, a welded cross grid of flat bars (two levels, forge
# weld at crossings), a central boss and a dark "water" disc just above the
# floor stones faking the pit below (the floor fill is a separate unit, so the
# disc must sit above its tallest stone, ~-0.002: y0 = -0.001).
# pit = 1 (D5): the room_fill cuts a real shaft under the grate — the fake
# water disc and the ashlar surround are dropped (the fill's own apron ring
# replaces the surround), the forged grate stays.
#
# F11/elements plane discipline (within-unit): rings are arc_shell sectors
# with a 0.6 deg forge-weld slit (no duplicate profile point), bar layers sit
# 2.5 mm apart and weld into each other and the rims (overlapping volumes,
# never shared planes), rivets/hub are spheres and spools buried in the flat
# stock, block tops carry a +/-1.5 mm jitter so neighbours never share a top
# plane. The rim and the block bottoms sink into the floor zone (y < 0): the
# intersection with the room_fill stones is cross-unit and reads as "set into
# the floor". Lib groups are stripped before output (assembly merge, D500).

import ashlar as a
import lib.plan as plan
import lib.ironwork as iron

def slot_version() -> (out: int) {
    out = 1
}

param p: geo<points>
param style: int = 1
param tag: int = 2
param rng_seed: int = 7
param pit: int = 0


root = rng_from_seed(rng_seed)
blk_rng = split_rng(root, key = "blocks")
fbm_rng = split_rng(root, key = "fbm")
yaw_rng = split_rng(root, key = "yaw")

at = value(@P, on = p)
probe = mesh_line(count = 1, length = 0.0)
yaw = value(random(0.0, 360.0, rng = yaw_rng), on = probe)

# Stone surround: 12 radial blocks, 2.4 deg gaps down to the floor's own
# joints. Per-block radius/top jitter; color from the shared ashlar ramp.
blocks = repeat (empty_mesh(), iterations = 12) |acc| {
    e = @iteration
    erng = split_rng(blk_rng, key = e)
    a0 = f32(e) * 30.0 + 1.2 + value(random(0.0 - 0.6, 0.6, rng = split_rng(erng, key = "a0")), on = probe)
    a1 = f32(e + 1) * 30.0 - 1.2 + value(random(0.0 - 0.6, 0.6, rng = split_rng(erng, key = "a1")), on = probe)
    rin = 0.295 + value(random(0.0 - 0.004, 0.004, rng = split_rng(erng, key = "ri")), on = probe)
    rout = 0.435 + value(random(0.0 - 0.006, 0.006, rng = split_rng(erng, key = "ro")), on = probe)
    ytop = 0.008 + value(random(0.0 - 0.0015, 0.0015, rng = split_rng(erng, key = "yt")), on = probe)
    blk = plan.arc_shell(cx = 0.0, cz = 0.0, r_in = rin, r_out = rout, a0 = a0, a1 = a1,
                         y0 = 0.0 - 0.006, y1 = ytop, grp = "stone", n = 6)
    shade = value(random(0.62, 1.04, rng = split_rng(erng, key = "shade")), on = probe)
    mot = value(random(0.25, 0.75, rng = split_rng(erng, key = "mot")), on = probe)
    warm = value(random(0.0, 1.0, rng = split_rng(erng, key = "warm")), on = probe)
    base = a.ashlar_color(style = style, shade = shade * 0.88, mot = mot)
    lum = dot(base, vec3(0.35, 0.55, 0.10))
    grayed = mix(base, vec3(lum, lum, lum), 0.55)
    tint = warm < 0.10 ? mix(grayed, vec3(0.48, 0.33, 0.22), 0.55) : grayed
    bs = set(blk, "style", style, domain = points)
    acc = merge(acc, set(bs, "Cd", tint, domain = points))
}
blocks_c = set(blocks, "Cd", @Cd * (0.92 + 0.16 * fbm(scale = 2.6, octaves = 2, rng = split_rng(fbm_rng, key = "stone"))), domain = points)

# Iron: rim + inner ring (flat stock, slit seam), cross grid of flat bars.
# Grid pitch 0.072, bar 0.016 x 0.006; ends bury 15 mm into the rim (chord of
# r = 0.27 > rim inner 0.255). Layer A rides on layer B (welded crossings).
rim = plan.arc_shell(cx = 0.0, cz = 0.0, r_in = 0.255, r_out = 0.285, a0 = 0.3, a1 = 359.7,
                     y0 = 0.0 - 0.012, y1 = 0.012, grp = "iron", n = 64)
ring_in = plan.arc_shell(cx = 0.0, cz = 0.0, r_in = 0.130, r_out = 0.145, a0 = 120.7, a1 = 479.3,
                         y0 = 0.001, y1 = 0.009, grp = "iron", n = 32)
bars_a = repeat (empty_mesh(), iterations = 7) |acc| {
    e = @iteration
    off = (f32(e) - 3.0) * 0.072
    half = sqrt(max(0.0729 - off * off, 0.001))
    bar = transform(box(size = vec3(half * 2.0, 0.006, 0.016), res = 1), translate = vec3(0.0, 0.008, off))
    acc = merge(acc, bar)
}
bars_b = repeat (empty_mesh(), iterations = 7) |acc| {
    e = @iteration
    off = (f32(e) - 3.0) * 0.072
    half = sqrt(max(0.0729 - off * off, 0.001))
    bar = transform(box(size = vec3(0.016, 0.006, half * 2.0), res = 1), translate = vec3(off, 0.0055, 0.0))
    acc = merge(acc, bar)
}
hub = iron.spool(p0 = vec3(0.0, 0.008, 0.0), p1 = vec3(0.0, 0.014, 0.0), r0 = 0.05, r1 = 0.042, sides = 16)
riv_rim = iron.bolt_heads(pts = plan.arc_mid_anchors(cx = 0.0, cz = 0.0, r = 0.27, y = 0.012, a0 = 15.0, a1 = 375.0, n = 8), r = 0.011)
riv_in = iron.bolt_heads(pts = plan.arc_mid_anchors(cx = 0.0, cz = 0.0, r = 0.1375, y = 0.008, a0 = 0.0, a1 = 360.0, n = 6), r = 0.008)

iron_rgb = vec3(0.12, 0.10, 0.085)
iron_m = merge(rim, ring_in, bars_a, bars_b, hub, riv_rim, riv_in)
iron_s = set(iron_m, "style", style, domain = points)
iron_c = set(iron_s, "Cd", iron_rgb * (0.85 + 0.30 * fbm(scale = 9.0, octaves = 2, rng = split_rng(fbm_rng, key = "iron"))), domain = points)

# The pit: thin near-black disc right above the tallest floor stone. Only in
# the solid-floor mode (pit = 0); with pit = 1 the room_fill shaft below the
# grate is real, and the fill's apron replaces the ashlar surround.
water_m = iron.spool(p0 = vec3(0.0, 0.0 - 0.001, 0.0), p1 = vec3(0.0, 0.001, 0.0), r0 = 0.27, r1 = 0.27, sides = 48)
water_s = set(water_m, "style", style, domain = points)
water_c = set(water_s, "Cd", vec3(0.015, 0.02, 0.028), domain = points)
stone_part = select(pit == 0, a = blocks_c, b = empty_mesh())
water_part = select(pit == 0, a = water_c, b = empty_mesh())

# Assembly-merge normalization (D500): strip lib groups and uv/t/N/tint
# (instance payload from bolt_heads), rebuild smooth normals, then the random
# yaw and the mount point.
merged = merge(stone_part, iron_c, water_part)
norm = unmark(unmark(unmark(unmark(merged, "iron"), "stone"), "water"), "edge")
clean = compute_normals(remove_attr(remove_attr(remove_attr(remove_attr(norm, "uv"), "t"), "N"), "tint"), mode = smooth)
mesh = transform(clean, rotate = vec3(0.0, yaw, 0.0), translate = at)

anchors = empty_points()

output mesh
output anchors
