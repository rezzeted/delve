# Delve slot asset: room_fill v2 (slots §2.1). Cobblestone floor (Roads-style
# setts on a running-bond grid: per-stone tint from the ashlar palette, micro
# tilt/scale jitter opening dark mortar joints to the bed below) with
# rng-picked accent patterns (medallion / border / cross) — clipped to the
# room contour, so figured plans (L, cross) get the floor, the mortar bed and
# the ceiling only inside the walls. Optional ceiling (style_ceil == 0 skips
# it: no-roof iso rooms). Barrel cluster for halls/crypts hugs an rng-picked
# polygon vertex (convex or concave — never outside the walls).
# Light anchor only with a ceiling; spawn for halls.

import codes as c
import props
import ashlar as a

def slot_version() -> (out: int) {
    out = 1
}

param contour: geo<points>
param h: f32 = 3.0
param role: int = 1
param style_floor: int = 1
param style_ceil: int = 3
param rng_seed: int = 7


lo, hi = bbox(contour)
sx = dot(hi - lo, (1, 0, 0))
sz = dot(hi - lo, (0, 0, 1))
cx = (dot(lo, (1, 0, 0)) + dot(hi, (1, 0, 0))) * 0.5
cz = (dot(lo, (0, 0, 1)) + dot(hi, (0, 0, 1))) * 0.5

root = rng_from_seed(rng_seed)
pat_rng = split_rng(root, key = "pattern")
bar_rng = split_rng(root, key = "barrels")
flr_rng = split_rng(root, key = "floor")
fbm_rng = split_rng(root, key = "fbm")
variant = value(random_int(4, rng = pat_rng), on = mesh_line(count = 1, length = 0.0))

pitch = 0.5
nx = int(floor(sx / pitch))
nz = int(floor(sz / pitch))
ox = cx - f32(nx) * pitch * 0.5
oz = cz - f32(nz) * pitch * 0.5

# Mortar bed and ceiling cells over the bbox pitch grid, clipped by the
# contour. A kept center overhangs the polygon edge by <= half a cell
# (0.23 m); the wall (thick/2 = 0.3 m) covers it. The ceiling slab only
# exists when the room has a ceiling at all.
cand = repeat (empty_points(), iterations = nx * nz) |acc| {
    e = @iteration
    p0 = transform(mesh_line(count = 1, length = 0.0),
                   translate = vec3(ox + (f32(e % nx) + 0.5) * pitch, 0.0,
                                    oz + (f32(e / nx) + 0.5) * pitch))
    acc = merge(acc, set(p0, "id", e, domain = points))
}
kept = delete(cand, where = !inside_polygon(contour))

bed = foreach cell in kept {
    tx = dot(value(@P, on = cell), (1, 0, 0))
    tz = dot(value(@P, on = cell), (0, 0, 1))
    bb = transform(box(size = vec3(pitch, 0.16, pitch), res = 1), translate = vec3(tx, 0.0 - 0.1205, tz))
    bs = set(bb, "style", style_floor, domain = points)
    bed_tile = set(bs, "Cd", a.mortar_color(style = style_floor, mot = 0.45) * 0.8, domain = points)
    cb = transform(box(size = vec3(pitch, 0.2, pitch), res = 1), translate = vec3(tx, h + 0.1, tz))
    cs = set(cb, "style", style_ceil, domain = points)
    ceil_tile = set(cs, "Cd", a.ashlar_color(style = style_ceil, shade = 0.72, mot = 0.3), domain = points)
    cell = merge(bed_tile, select(style_ceil != 0, a = ceil_tile, b = empty_mesh()))
}

# Sett anchors: running-bond grid (odd rows shift half a stone), centers kept
# inside the contour. Per stone: @tint from the ashlar ramp (floors read
# darker than walls, ~10% warm stones), @scale opens the mortar joint, micro
# tilt/yaw/height jitter keeps neighbour tops out of plane.
spx = 0.42
spz = 0.38
snx = int(floor(sx / spx))
snz = int(floor(sz / spz))
sox = cx - f32(snx) * spx * 0.5
soz = cz - f32(snz) * spz * 0.5
stone_w = 0.38
stone_l = 0.34
stone_h = 0.07

cloud = repeat (empty_points(), iterations = snx * snz) |acc| {
    e = @iteration
    r = e / snx
    cc = e % snx
    bond = r % 2 == 1 ? spx * 0.5 : 0.0
    px0 = sox + (f32(cc) + 0.5) * spx + bond
    pz0 = soz + (f32(r) + 0.5) * spz
    pt0 = transform(mesh_line(count = 1, length = 0.0), translate = vec3(px0, 0.0, pz0))
    inside = value(inside_polygon(contour), on = pt0)
    erng = split_rng(flr_rng, key = e)
    shade = value(random(0.62, 1.04, rng = split_rng(erng, key = "shade")), on = pt0)
    mot = value(0.5 + 0.5 * fbm(scale = 1.9, octaves = 2, rng = split_rng(erng, key = "mot")), on = pt0)
    base = a.ashlar_color(style = style_floor, shade = shade * 0.88, mot = mot)
    lum = dot(base, vec3(0.35, 0.55, 0.10))
    grayed = mix(base, vec3(lum, lum, lum), 0.55)
    warm = value(random(0.0, 1.0, rng = split_rng(erng, key = "warm")), on = pt0)
    toned = warm < 0.10 ? mix(grayed, vec3(0.48, 0.33, 0.22), 0.55) : grayed
    dxc = px0 - cx
    dzc = pz0 - cz
    dc = sqrt(dxc * dxc + dzc * dzc)
    edge = min(min(px0 - sox, sox + f32(snx) * spx - px0), min(pz0 - soz, soz + f32(snz) * spz - pz0))
    a_med = dc < min(sx, sz) * 0.25
    a_bord = edge < spx
    a_cross = (sqrt(dxc * dxc) < spx * 0.75) | (sqrt(dzc * dzc) < spx * 0.75)
    accent = variant == 1 ? a_med : (variant == 2 ? a_bord : (variant == 3 ? a_cross : false))
    band = f32(int(dc / (spx * 2.0)) % 2)
    amt = variant == 1 ? 0.38 + 0.22 * band : 0.48
    tint = accent ? mix(toned, vec3(0.44, 0.25, 0.15), amt) * 0.88 : toned
    pt1 = set(pt0, "style", style_floor, domain = points)
    pt2 = set(pt1, "tint", tint, domain = points)
    pt3 = set(pt2, "scale", value(random(0.93, 1.0, rng = split_rng(erng, key = "scale")), on = pt0), domain = points)
    tj = value(random(0.0 - 1.1, 1.1, rng = split_rng(erng, key = "tiltp")), on = pt0)
    rj = value(random(0.0 - 1.1, 1.1, rng = split_rng(erng, key = "tiltr")), on = pt0)
    yj = value(random(0.0 - 2.5, 2.5, rng = split_rng(erng, key = "yawj")), on = pt0)
    pt4 = set(pt3, "orient", orient_from_euler(vec3(tj, yj, rj)), domain = points)
    pt5 = set_position(pt4, offset = vec3(0.0, value(random(0.0 - 0.006, 0.008, rng = split_rng(erng, key = "dy")), on = pt0), 0.0))
    acc = merge(acc, select(inside, a = pt5, b = empty_points()))
}

# Stone tops stay strictly below y=0 (max rise from dy+tilt is ~0.013): F11
# opening_voids counts any styled face above 0 in a doorway band.
stone = compute_normals(transform(box(size = vec3(stone_w, stone_h, stone_l), res = 1), translate = vec3(0.0, 0.0 - stone_h * 0.5 - 0.014, 0.0)), mode = flat)
floor_r = realize(instance_on_points(cloud, source = stone))
floor_s = set(floor_r, "style", style_floor, domain = points)
floor_c = set(floor_s, "Cd", @tint * (0.90 + 0.20 * fbm(scale = 2.6, octaves = 2, rng = fbm_rng)), domain = points)

# Barrel cluster (halls/crypts): L-pile of up to 3 at an rng-picked polygon
# vertex, hugging the two walls of its corner. The probe decides which side
# of the edges is the room (convex corner: +edges; concave 270°: -edges), so
# the pile never lands outside the walls. Reaching 0.62+0.78 m along a wall
# it neither blocks a doorway (doors start >= 2 m from every corner) nor
# sinks into a wall face (barrel r <= 0.32; wall face at thick/2 = 0.3).
is_store = (role == c.RL_HALL()) | (role == c.RL_CRYPT())
nb = 1 + value(random_int(3, rng = bar_rng), on = mesh_line(count = 1, length = 0.0))
nv = count(contour)
csel = value(random_int(nv, rng = split_rng(bar_rng, key = "corner")), on = mesh_line(count = 1, length = 0.0))
pv = value(@P, on = contour, where = @index == csel)
pn = value(@P, on = contour, where = @index == (csel + 1) % nv)
pp = value(@P, on = contour, where = @index == (csel + nv - 1) % nv)
e1 = normalize(pn - pv)
e2 = normalize(pp - pv)
probe_plus = transform(mesh_line(count = 1, length = 0.0), translate = pv + (e1 + e2) * 0.62)
sgn = value(inside_polygon(contour), on = probe_plus) ? 1.0 : 0.0 - 1.0
nook = pv + (e1 + e2) * (sgn * 0.62)
b0 = props.barrel(rng = bar_rng)
barrels = repeat (empty_mesh(), iterations = nb) |acc| {
    k = @iteration
    ax = 0.62 + 0.78 * (k == 1 ? 1.0 : 0.0)
    az = 0.62 + 0.78 * (k == 2 ? 1.0 : 0.0)
    yaw = f32((k * 53 + csel * 17) % 360)
    bm = transform(b0, rotate = vec3(0.0, yaw, 0.0), translate = pv + e1 * (sgn * ax) + e2 * (sgn * az))
    acc = merge(acc, bm)
}
barrel_part = select(is_store, a = barrels, b = empty_mesh())

# Occupied-volume blockers (C4): one anchor per barrel at its footprint
# center, @range = cylinder radius with a small margin. delve fill strips
# kind=4 anchors into the occupied registry; decor rules keep clear of them.
blk = repeat (empty_points(), iterations = nb) |acc| {
    k = @iteration
    ax = 0.62 + 0.78 * (k == 1 ? 1.0 : 0.0)
    az = 0.62 + 0.78 * (k == 2 ? 1.0 : 0.0)
    bp = transform(mesh_line(count = 1, length = 0.0),
                   translate = pv + e1 * (sgn * ax) + e2 * (sgn * az))
    b1 = set(bp, "kind", c.AK_BLOCKER(), domain = points)
    b2 = set(b1, "dir", vec3(0.0, 1.0, 0.0), domain = points, typeinfo = vector)
    b3 = set(b2, "range", 0.36, domain = points)
    acc = merge(acc, b3)
}
blockers = select(is_store, a = blk, b = empty_points())

# Assembly-merge normalization: drop the instance payload (@tint) and every
# normal, then rebuild smooth corner normals so no vec2/mixed-N reaches the
# level merge (D500).
merged = merge(bed, floor_c, barrel_part)
mesh = compute_normals(remove_attr(remove_attr(merged, "tint"), "N"), mode = smooth)

# Anchors sit at the bbox center when it is inside the room (rects, crosses);
# otherwise they fall back to the barrel nook, which is always inside.
center_probe = transform(mesh_line(count = 1, length = 0.0), translate = vec3(cx, 0.0, cz))
center_ok = value(inside_polygon(contour), on = center_probe)
ax0 = center_ok ? cx : dot(nook, (1, 0, 0))
az0 = center_ok ? cz : dot(nook, (0, 0, 1))

lamp0 = transform(mesh_line(count = 1, length = 0.0), translate = vec3(ax0, h - 0.3, az0))
lamp1 = set(lamp0, "kind", c.AK_LIGHT(), domain = points)
lamp2 = set(lamp1, "dir", vec3(0.0, 0.0 - 1.0, 0.0), domain = points, typeinfo = vector)
lamp = set(lamp2, "range", 6.0, domain = points)

spawn0 = transform(mesh_line(count = 1, length = 0.0), translate = vec3(ax0, 0.0, az0))
spawn1 = set(spawn0, "kind", c.AK_SPAWN(), domain = points)
spawn2 = set(spawn1, "dir", vec3(0.0, 0.0, 1.0), domain = points, typeinfo = vector)
spawn = set(spawn2, "range", 0.0, domain = points)

anchors = merge(select(style_ceil != 0, a = lamp, b = empty_points()), select(role == c.RL_HALL(), a = spawn, b = empty_points()), blockers)

output mesh
output anchors
