# Delve slot asset: room_fill v2 (slots §2.1). Stone-tile floor with accent
# patterns (medallion / border / cross, rng-picked) clipped to the room
# contour — figured plans (L, cross) get the floor, the mortar bed and the
# ceiling only inside the walls. Optional ceiling (style_ceil == 0 skips it:
# no-roof iso rooms). Barrel cluster for halls/crypts hugs an rng-picked
# polygon vertex (convex or concave — never outside the walls).
# Light anchor only with a ceiling; spawn for halls.

import codes as c
import props

def slot_version() -> (out: int) {
    out = 1
}

param contour: geo<points>
param h: f32 = 3.0
param role: int = 1
param style_floor: int = 1
param style_ceil: int = 3
param rng_seed: int = 7


lo, hi = bbox(contour)
sx = dot(hi - lo, (1, 0, 0))
sz = dot(hi - lo, (0, 0, 1))
cx = (dot(lo, (1, 0, 0)) + dot(hi, (1, 0, 0))) * 0.5
cz = (dot(lo, (0, 0, 1)) + dot(hi, (0, 0, 1))) * 0.5

root = rng_from_seed(rng_seed)
pat_rng = split_rng(root, key = "pattern")
bar_rng = split_rng(root, key = "barrels")
variant = value(random_int(4, rng = pat_rng), on = mesh_line(count = 1, length = 0.0))

pitch = 0.5
tile = 0.46
nx = int(floor(sx / pitch))
nz = int(floor(sz / pitch))
ox = cx - f32(nx) * pitch * 0.5
oz = cz - f32(nz) * pitch * 0.5
base_col = c.style_color(style = style_floor)
accent_col = c.style_color(style = c.ST_BRICK())

# Tile centers over the bbox pitch grid, clipped by the contour. A kept
# center overhangs the polygon edge by <= half a tile (0.23 m); the wall
# (thick/2 = 0.3 m) covers it. The grid id rides along for the pattern
# areas and the Cd jitter below.
cand = repeat (empty_points(), iterations = nx * nz) |acc| {
    e = @iteration
    p0 = transform(mesh_line(count = 1, length = 0.0),
                   translate = vec3(ox + (f32(e % nx) + 0.5) * pitch, 0.0,
                                    oz + (f32(e / nx) + 0.5) * pitch))
    acc = merge(acc, set(p0, "id", e, domain = points))
}
kept = delete(cand, where = !inside_polygon(contour))

# Mortar bed and ceiling slab per kept cell: both clip like the floor (the
# ceiling slab only exists when the room has a ceiling at all).
bed = foreach cell in kept {
    tx = dot(value(@P, on = cell), (1, 0, 0))
    tz = dot(value(@P, on = cell), (0, 0, 1))
    bb = transform(box(size = vec3(pitch, 0.16, pitch), res = 1), translate = vec3(tx, 0.0 - 0.1205, tz))
    bs = set(bb, "style", style_floor, domain = points)
    bed_tile = set(bs, "Cd", c.style_color_mortar(style = style_floor), domain = points)
    cb = transform(box(size = vec3(pitch, 0.2, pitch), res = 1), translate = vec3(tx, h + 0.1, tz))
    cs = set(cb, "style", style_ceil, domain = points)
    ceil_tile = set(cs, "Cd", c.style_color(style = style_ceil), domain = points)
    cell = merge(bed_tile, select(style_ceil != 0, a = ceil_tile, b = empty_mesh()))
}

tiles = foreach cell in kept {
    e = value(@id, on = cell)
    tx = dot(value(@P, on = cell), (1, 0, 0))
    tz = dot(value(@P, on = cell), (0, 0, 1))
    dxc = tx - cx
    dzc = tz - cz
    dc = sqrt(dxc * dxc + dzc * dzc)
    edge = min(min(tx - ox, ox + f32(nx) * pitch - tx), min(tz - oz, oz + f32(nz) * pitch - tz))
    a_med = dc < min(sx, sz) * 0.25
    a_bord = edge < pitch
    a_cross = (sqrt(dxc * dxc) < pitch * 0.75) | (sqrt(dzc * dzc) < pitch * 0.75)
    accent = variant == 1 ? a_med : (variant == 2 ? a_bord : (variant == 3 ? a_cross : false))
    tb = box(size = vec3(tile, 0.04, tile), res = 1)
    tm = transform(tb, translate = vec3(tx, 0.0 - 0.02, tz))
    ti = set(tm, "id", e, domain = points)
    ts = set(ti, "style", style_floor, domain = points)
    cell = set(ts, "Cd", accent ? accent_col : base_col, domain = points)
}

hv = sin(f32(@id) * 12.9898) * 43758.5453
jit = 0.94 + (hv - floor(hv)) * 0.12
tiles_c = set(tiles, "Cd", @Cd * jit, domain = points)

# Barrel cluster (halls/crypts): L-pile of up to 3 at an rng-picked polygon
# vertex, hugging the two walls of its corner. The probe decides which side
# of the edges is the room (convex corner: +edges; concave 270°: -edges), so
# the pile never lands outside the walls. Reaching 0.62+0.78 m along a wall
# it neither blocks a doorway (doors start >= 2 m from every corner) nor
# sinks into a wall face (barrel r <= 0.32; wall face at thick/2 = 0.3).
is_store = (role == c.RL_HALL()) | (role == c.RL_CRYPT())
nb = 1 + value(random_int(3, rng = bar_rng), on = mesh_line(count = 1, length = 0.0))
nv = count(contour)
csel = value(random_int(nv, rng = split_rng(bar_rng, key = "corner")), on = mesh_line(count = 1, length = 0.0))
pv = value(@P, on = contour, where = @index == csel)
pn = value(@P, on = contour, where = @index == (csel + 1) % nv)
pp = value(@P, on = contour, where = @index == (csel + nv - 1) % nv)
e1 = normalize(pn - pv)
e2 = normalize(pp - pv)
probe_plus = transform(mesh_line(count = 1, length = 0.0), translate = pv + (e1 + e2) * 0.62)
sgn = value(inside_polygon(contour), on = probe_plus) ? 1.0 : 0.0 - 1.0
nook = pv + (e1 + e2) * (sgn * 0.62)
b0 = props.barrel(rng = bar_rng)
barrels = repeat (empty_mesh(), iterations = nb) |acc| {
    k = @iteration
    ax = 0.62 + 0.78 * (k == 1 ? 1.0 : 0.0)
    az = 0.62 + 0.78 * (k == 2 ? 1.0 : 0.0)
    yaw = f32((k * 53 + csel * 17) % 360)
    bm = transform(b0, rotate = vec3(0.0, yaw, 0.0), translate = pv + e1 * (sgn * ax) + e2 * (sgn * az))
    acc = merge(acc, bm)
}
barrel_part = select(is_store, a = barrels, b = empty_mesh())

mesh = merge(bed, tiles_c, barrel_part)

# Anchors sit at the bbox center when it is inside the room (rects, crosses);
# otherwise they fall back to the barrel nook, which is always inside.
center_probe = transform(mesh_line(count = 1, length = 0.0), translate = vec3(cx, 0.0, cz))
center_ok = value(inside_polygon(contour), on = center_probe)
ax0 = center_ok ? cx : dot(nook, (1, 0, 0))
az0 = center_ok ? cz : dot(nook, (0, 0, 1))

lamp0 = transform(mesh_line(count = 1, length = 0.0), translate = vec3(ax0, h - 0.3, az0))
lamp1 = set(lamp0, "kind", c.AK_LIGHT(), domain = points)
lamp2 = set(lamp1, "dir", vec3(0.0, 0.0 - 1.0, 0.0), domain = points, typeinfo = vector)
lamp = set(lamp2, "range", 6.0, domain = points)

spawn0 = transform(mesh_line(count = 1, length = 0.0), translate = vec3(ax0, 0.0, az0))
spawn1 = set(spawn0, "kind", c.AK_SPAWN(), domain = points)
spawn2 = set(spawn1, "dir", vec3(0.0, 0.0, 1.0), domain = points, typeinfo = vector)
spawn = set(spawn2, "range", 0.0, domain = points)

anchors = merge(select(style_ceil != 0, a = lamp, b = empty_points()), select(role == c.RL_HALL(), a = spawn, b = empty_points()))

output mesh
output anchors
